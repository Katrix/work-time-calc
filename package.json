{
  "name": "work-time-calc",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "eslint --config eslint.config.ts",
    "fixlint": "eslint --config eslint.config.ts --fix",
    "format-check": "prettier --check \"**/*.(md|yaml|json|ts|vue)\"",
    "format": "prettier --write \"**/*.(md|yaml|json|ts|vue)\"",
    "db:generate": "prisma generate",
    "db:recreate-local": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply work-time-calc --local",
    "db:make-initial-migration": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "db:make-migration": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@octokit/types": "^18.0.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-security": "^4.2.0",
    "get-graphql-schema": "^2.1.2",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "neostandard": "^0.14.1",
    "nitro-cloudflare-dev": "^0.2.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "sass": "^1.107.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.155.0"
  },
  "dependencies": {
    "@bootstrap-vue-next/nuxt": "^1.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@js-temporal/polyfill": "^0.5.1",
    "@octokit/auth-oauth-user": "^6.0.4",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-paginate-rest": "^16.0.0",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
    "@pinia/nuxt": "1.0.3",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/vue-query": "^5.105.0",
    "@tanstack/vue-query-devtools": "^6.3.6",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^1.2.2",
    "csv-stringify": "^6.9.0",
    "date-easter": "^1.0.3",
    "devalue": "^6.0.3",
    "fast-deep-equal": "^3.1.3",
    "fflate": "^0.8.3",
    "fractional-indexing": "^4.0.0",
    "klona": "^2.0.6",
    "nanoid": "^6.0.2",
    "nuxt": "^4.6.3",
    "nuxt-auth-utils": "0.5.34",
    "nuxt-security": "2.7.0",
    "nuxt-viewport": "2.6.1",
    "pinia": "^4.1.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "packageManager": "yarn@4.10.3"
}
